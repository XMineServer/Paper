From: sidey383 <sidey383@mail.ru>
Date: Fri, 14 Aug 2026 06:27:49 +0300
Subject: [PATCH] XMine: Read the Velocity forwarding secret from the
 environment
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Секрет Velocity-форвардинга больше не обязан лежать в paper.yml: этот файл
живёт в примонтированном томе, который читают разработчики и read-only
учётки. PaperConfig#velocitySupport берёт секрет по приоритету — файл, путь
к которому задан в PAPER_VELOCITY_SECRET_FILE, затем PAPER_VELOCITY_SECRET,
затем settings.velocity-support.secret как было раньше.

У файлов-секретов почти всегда есть завершающий перевод строки, поэтому
концевые пробельные символы обрезаются, чтобы не попасть в ключ HMAC.
Если PAPER_VELOCITY_SECRET_FILE задана, но файл отсутствует, не читается или
пуст — в лог уходит внятная ошибка, после чего берётся следующий источник.

Сам секрет в лог не попадает ни целиком, ни частично: логируется только его
источник. Поведение fatal() при включённом форвардинге и пустом секрете
сохранено — оно защищает от молчаливо сломанной авторизации.

Имена переменных среды совпадают с актуальными версиями Paper, чтобы при
будущем переезде на новую версию ничего не пришлось переучивать.

diff --git a/src/main/java/com/destroystokyo/paper/PaperConfig.java b/src/main/java/com/destroystokyo/paper/PaperConfig.java
index 7acf077bc131af718c7548cc29deef558c04e463..b9f01e5d2404226d8c102685247c9887a0618a9f 100644
--- a/src/main/java/com/destroystokyo/paper/PaperConfig.java
+++ b/src/main/java/com/destroystokyo/paper/PaperConfig.java
@@ -344,10 +344,35 @@ public class PaperConfig {
     public static boolean velocitySupport;
     public static boolean velocityOnlineMode;
     public static byte[] velocitySecretKey;
+    // XMine start - секрет Velocity-форвардинга из окружения
+    // Имена переменных взяты из актуальных версий Paper, чтобы при переезде на новую версию
+    // ничего не пришлось переучивать.
+    private static final String VELOCITY_SECRET_ENV = "PAPER_VELOCITY_SECRET";
+    private static final String VELOCITY_SECRET_FILE_ENV = "PAPER_VELOCITY_SECRET_FILE";
+    // XMine end - секрет Velocity-форвардинга из окружения
     private static void velocitySupport() {
         velocitySupport = getBoolean("settings.velocity-support.enabled", false);
         velocityOnlineMode = getBoolean("settings.velocity-support.online-mode", false);
         String secret = getString("settings.velocity-support.secret", "");
+        // XMine start - секрет Velocity-форвардинга из окружения
+        // Секрет не должен лежать в paper.yml: этот файл живёт в примонтированном томе, который читают
+        // разработчики и read-only учётки. Порядок приоритета: файл из PAPER_VELOCITY_SECRET_FILE ->
+        // PAPER_VELOCITY_SECRET -> settings.velocity-support.secret (последнее — для обратной совместимости).
+        // Сам секрет в лог не попадает ни при каких условиях, логируется только его источник.
+        String secretSource = "paper.yml (settings.velocity-support.secret)";
+        String secretFromFile = readVelocitySecretFile(System.getenv(VELOCITY_SECRET_FILE_ENV));
+        String secretFromEnv = System.getenv(VELOCITY_SECRET_ENV);
+        if (secretFromFile != null) {
+            secret = secretFromFile;
+            secretSource = "the file pointed to by " + VELOCITY_SECRET_FILE_ENV;
+        } else if (secretFromEnv != null && !secretFromEnv.isEmpty()) {
+            secret = secretFromEnv;
+            secretSource = "the " + VELOCITY_SECRET_ENV + " environment variable";
+        }
+        if (velocitySupport && !secret.isEmpty()) {
+            Bukkit.getLogger().info("Velocity IP forwarding: secret loaded from " + secretSource);
+        }
+        // XMine end - секрет Velocity-форвардинга из окружения
         if (velocitySupport && secret.isEmpty()) {
             fatal("Velocity support is enabled, but no secret key was specified. A secret key is required!");
         } else {
@@ -355,6 +380,41 @@ public class PaperConfig {
         }
     }
 
+    // XMine start - секрет Velocity-форвардинга из окружения
+    // Возвращает содержимое файла-секрета или null, если переменная не задана либо файл прочитать не удалось.
+    // Нечитаемый файл — это ошибка конфигурации, а не повод молча свалиться на следующий источник,
+    // поэтому о ней громко сообщается в лог (без содержимого файла, только путь).
+    private static String readVelocitySecretFile(String path) {
+        if (path == null || path.isEmpty()) {
+            return null;
+        }
+        String secret;
+        try {
+            secret = new String(java.nio.file.Files.readAllBytes(java.nio.file.Paths.get(path)), StandardCharsets.UTF_8);
+        } catch (IOException | java.nio.file.InvalidPathException ex) {
+            logError("Could not read the Velocity forwarding secret from the file pointed to by "
+                    + VELOCITY_SECRET_FILE_ENV + " (" + path + "): " + ex.getMessage());
+            return null;
+        }
+        // У файлов-секретов почти всегда есть завершающий перевод строки, в ключ HMAC он попасть не должен.
+        secret = trimTrailingWhitespace(secret);
+        if (secret.isEmpty()) {
+            logError("The Velocity forwarding secret file pointed to by " + VELOCITY_SECRET_FILE_ENV
+                    + " (" + path + ") is empty");
+            return null;
+        }
+        return secret;
+    }
+
+    private static String trimTrailingWhitespace(String value) {
+        int end = value.length();
+        while (end > 0 && Character.isWhitespace(value.charAt(end - 1))) {
+            end--;
+        }
+        return value.substring(0, end);
+    }
+    // XMine end - секрет Velocity-форвардинга из окружения
+
     public static int maxBookPageSize = 2560;
     public static double maxBookTotalSizeMultiplier = 0.98D;
     private static void maxBookSize() {
