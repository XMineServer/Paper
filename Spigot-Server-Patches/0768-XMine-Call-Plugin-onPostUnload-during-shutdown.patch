From: sidey383 <sidey383@mail.ru>
Date: Fri, 7 Aug 2026 03:45:11 +0300
Subject: [PATCH] XMine: Call Plugin#onPostUnload during shutdown

Runs the post-unload phase at the very end of MinecraftServer#stop: the
worlds are saved, closed and unlocked, chunk IO is flushed and the worker
pools are down, but the plugin class loaders and the console appender are
still open so plugins can still run code and log. Both are closed
immediately afterwards.

Also snapshots the resolved world container path in the CraftServer
constructor, while the level session is guaranteed to be open, so
Server#getWorldContainerPath stays readable from onPostUnload.

diff --git a/src/main/java/net/minecraft/server/MinecraftServer.java b/src/main/java/net/minecraft/server/MinecraftServer.java
index 0737009363635c677246642f371847c9100e49a8..73642da140e320d8275ce4758d809ee00eb3becd 100644
--- a/src/main/java/net/minecraft/server/MinecraftServer.java
+++ b/src/main/java/net/minecraft/server/MinecraftServer.java
@@ -969,6 +969,18 @@ public abstract class MinecraftServer extends IAsyncTaskHandlerReentrant<TickTas
         com.destroystokyo.paper.io.PaperFileIOThread.Holder.INSTANCE.close(true, true); // Paper
         LOGGER.info("Closing Thread Pool");
         SystemUtils.shutdownServerThreadPool(); // Paper
+        // XMine start - postUnload - let plugins touch the world files once everything is flushed and closed
+        // Deliberately last: worlds are saved, closed and unlocked, chunk IO is flushed and the thread pools are
+        // down, but the plugin class loaders and the console appender are still open (both are closed right after).
+        if (this.server != null) {
+            LOGGER.info("Post-unloading plugins");
+            try {
+                this.server.postUnloadPlugins();
+            } catch (Throwable throwable) {
+                LOGGER.error("Exception post-unloading plugins", throwable);
+            }
+        }
+        // XMine end - postUnload
         LOGGER.info("Closing Server");
         try {
             net.minecrell.terminalconsole.TerminalConsoleAppender.close(); // Paper - Use TerminalConsoleAppender
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 894c7834f8e5829058e5004829a795a1004510bf..689fd93865cd6fa57d55be581865e5806bd347b0 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -241,6 +241,7 @@ public final class CraftServer implements Server {
     private final StandardMessenger messenger = new StandardMessenger();
     private final SimplePluginManager pluginManager = new SimplePluginManager(this, commandMap);
     protected final DedicatedServer console;
+    private final java.nio.file.Path worldContainerPath; // XMine - resolved world container path
     protected final DedicatedPlayerList playerList;
     private final Map<String, World> worlds = new LinkedHashMap<String, World>();
     private YamlConfiguration configuration;
@@ -276,6 +277,11 @@ public final class CraftServer implements Server {
 
     public CraftServer(DedicatedServer console, PlayerList playerList) {
         this.console = console;
+        // XMine start - resolved world container path - snapshot it here, while the level session is guaranteed to be
+        // open; the location cannot change at runtime, and it must stay readable from Plugin#onPostUnload()
+        // Absolutise before taking the parent: --universe "" gives a one-element level path with a null parent.
+        this.worldContainerPath = console.convertable.folder.toAbsolutePath().normalize().getParent();
+        // XMine end - resolved world container path
         this.playerList = (DedicatedPlayerList) playerList;
         this.playerView = Collections.unmodifiableList(Lists.transform(playerList.players, new Function<EntityPlayer, CraftPlayer>() {
             @Override
@@ -449,9 +455,16 @@ public final class CraftServer implements Server {
     }
 
     public void disablePlugins() {
+        pluginManager.beginShutdown(); // XMine - postUnload - only reached from MinecraftServer#stop, so the postUnload phase always follows
         pluginManager.disablePlugins();
     }
 
+    // XMine start - postUnload
+    public void postUnloadPlugins() {
+        pluginManager.postUnloadPlugins();
+    }
+    // XMine end - postUnload
+
     private void setVanillaCommands(boolean first) { // Spigot
         CommandDispatcher dispatcher = console.vanillaCommandDispatcher;
 
@@ -1805,6 +1818,13 @@ public final class CraftServer implements Server {
         return this.getServer().convertable.a(net.minecraft.world.level.World.OVERWORLD).getParentFile();
     }
 
+    // XMine start - resolved world container path
+    @Override
+    public java.nio.file.Path getWorldContainerPath() {
+        return this.worldContainerPath;
+    }
+    // XMine end - resolved world container path
+
     @Override
     public OfflinePlayer[] getOfflinePlayers() {
         WorldNBTStorage storage = console.worldNBTStorage;
