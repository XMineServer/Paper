diff --git a/src/main/java/org/bukkit/plugin/java/JavaPluginLoader.java b/src/main/java/org/bukkit/plugin/java/JavaPluginLoader.java
index b622cedeeee017f042bcf92485d81832030a8030..bf576b6958cec822285e7033bca5b33f8cdb3ff1 100644
--- a/src/main/java/org/bukkit/plugin/java/JavaPluginLoader.java
+++ b/src/main/java/org/bukkit/plugin/java/JavaPluginLoader.java
@@ -259,6 +259,51 @@ public final class JavaPluginLoader implements PluginLoader {
         }
     }
 
+    // XMine start - postUnload - defer class loader teardown until after Plugin#onPostUnload
+    private volatile boolean deferLoaderTeardown = false;
+    private final List<PluginClassLoader> deferredLoaders = new CopyOnWriteArrayList<PluginClassLoader>();
+
+    /**
+     * Makes {@link #disablePlugin(Plugin, boolean)} record the plugin class
+     * loaders instead of tearing them down, so that {@link Plugin#onPostUnload()}
+     * can still load classes and read resources out of the plugin jar.
+     * <p>
+     * Only ever enabled by the server itself, for the duration of the shutdown
+     * sequence. Must be paired with {@link #closeDeferredClassLoaders()}.
+     */
+    public void setDeferClassLoaderTeardown(boolean defer) {
+        this.deferLoaderTeardown = defer;
+    }
+
+    /**
+     * Tears down every class loader whose teardown was deferred, and stops
+     * deferring.
+     */
+    public void closeDeferredClassLoaders() {
+        this.deferLoaderTeardown = false;
+        for (PluginClassLoader loader : deferredLoaders) {
+            teardownClassLoader(loader);
+        }
+        deferredLoaders.clear();
+    }
+
+    private void teardownClassLoader(@NotNull PluginClassLoader loader) {
+        loaders.remove(loader);
+
+        Collection<Class<?>> classes = loader.getClasses();
+
+        for (Class<?> clazz : classes) {
+            removeClass(clazz);
+        }
+
+        try {
+            loader.close();
+        } catch (IOException ex) {
+            //
+        }
+    }
+    // XMine end - postUnload
+
     private void removeClass(@NotNull Class<?> clazz) {
         if (ConfigurationSerializable.class.isAssignableFrom(clazz)) {
             Class<? extends ConfigurationSerializable> serializable = clazz.asSubclass(ConfigurationSerializable.class);
@@ -409,19 +454,13 @@ public final class JavaPluginLoader implements PluginLoader {
 
             if (cloader instanceof PluginClassLoader) {
                 PluginClassLoader loader = (PluginClassLoader) cloader;
-                loaders.remove(loader);
-
-                Collection<Class<?>> classes = loader.getClasses();
-
-                for (Class<?> clazz : classes) {
-                    removeClass(clazz);
-                }
-
-                try {
-                    loader.close();
-                } catch (IOException ex) {
-                    //
+                // XMine start - postUnload - keep the class loader usable until Plugin#onPostUnload has run
+                if (this.deferLoaderTeardown) {
+                    this.deferredLoaders.add(loader);
+                    return;
                 }
+                teardownClassLoader(loader);
+                // XMine end - postUnload
                 // Paper start - close Class Loader on disable
                 try {
                     if (closeClassloader) {
